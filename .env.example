APP_NAME="Regional Referral Hospital HMS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://hms.example.go.tz
APP_TIMEZONE=Africa/Dar_es_Salaam

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Core datastore: MySQL 8.0 (MariaDB compatible for local development).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hospital_management_system
DB_USERNAME=hms_app
DB_PASSWORD=

# Reference production drivers use Redis (authenticated, private interface, TLS).
SESSION_DRIVER=redis
SESSION_LIFETIME=720
SESSION_ENCRYPT=true
SESSION_DOMAIN=null

QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=hms

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_FROM_ADDRESS="no-reply@hospital.go.tz"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# HMS configuration
# ---------------------------------------------------------------------------
HMS_FACILITY_CODE=RHH001
HMS_SESSION_IDLE_MINUTES=15
HMS_SESSION_ABSOLUTE_HOURS=12
HMS_SESSION_CONCURRENT_LIMIT=3
HMS_PASSWORD_MIN_LENGTH=12
HMS_PASSWORD_BREACH_CHECK=true
HMS_MFA_REQUIRED_ACTIONS=admin,prescribe
HMS_BREAK_GLASS_MINUTES=60
HMS_INTEGRATION_MODE=mock
HMS_CLINICAL_REPLICA_MAX_LAG_SECONDS=2
